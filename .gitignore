
venv

.env
__pycache__/
*.pyc

__pychache__
cira/records

# Runtime state for the evaluation run lock — never a result.
evaluation/outputs/reports/.run_lock

# Live run log. The frozen result set is outputs/, not the console transcript.
evaluation/full_run.log
evaluation/*.log

# Agent-side record dumps written during a run. Debris, never a result -
# the result set is evaluation/outputs*/.
evaluation/records/

# Intake records. core/storage.py writes these relative to the directory the
# server was started in, so they land here whenever it is started from the
# checkout. They are patient data and must never be committed.
records/

# Local editor and preview configuration.
.claude/
