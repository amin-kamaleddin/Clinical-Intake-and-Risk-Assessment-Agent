# Copy to .env at the project root (the folder containing cira/) and fill in.
# Never commit the real file. If it has ever been committed, rotate the key.

OPENAI_API_KEY=sk-...

# Optional - the defaults are in cira/core/config.py.
# CIRA_MODEL=gpt-5.6-luna
# CIRA_STT_MODEL=gpt-4o-transcribe
# CIRA_TTS_MODEL=gpt-4o-mini-tts
# CIRA_TTS_VOICE=shimmer

# Where the service listens. 0.0.0.0 exposes it beyond this machine, which is
# only safe behind something that terminates TLS and authenticates the user.
# CIRA_HOST=127.0.0.1
# CIRA_PORT=8000

# Keeping records off the instance, for a host whose disk does not survive a
# restart. The repository MUST be private - a public one publishes every
# intake. Unset, nothing is uploaded. See "Keeping records" in cira/README.md.
# CIRA_RECORD_REPO=owner/cira-records
# CIRA_RECORD_TOKEN=github_pat_...
# CIRA_RECORD_BRANCH=main
# CIRA_RECORD_PREFIX=records
# CIRA_RECORD_FLUSH=60

# Writes records to this directory instead of wherever the server was started.
# CIRA_RECORD_DIR=/data
